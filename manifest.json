{
  "manifest_version": 3,
  "name": "Sound Control",
  "description": "Control the volume of each browser tab individually",
  "version": "2.0.0",
  "action": {
    "default_popup": "html/popup.html",
    "default_title": "Sound Control",
    "default_icon": {
      "48": "image/48.png",
      "128": "image/128.png"
    }
  },
  "icons": {
    "48": "image/48.png",
    "128": "image/128.png"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "permissions": [
    "tabs",
    "tabCapture",
    "offscreen"
  ]
}
